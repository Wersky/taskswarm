{
  "name": "taskswarm",
  "version": "2.2.0",
  "description": "TaskSwarm: recursive task decomposition, wave-based parallel subagent dispatch, and a shared MCP progress board. Zero dependencies, Node >= 18. Includes a PPR review gate: a task with a reviewer stays blocked (downstream cannot start) until the reviewer approves.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Wersky",
    "url": "https://github.com/Wersky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wersky/taskswarm.git"
  },
  "homepage": "https://github.com/Wersky/taskswarm#readme",
  "bugs": {
    "url": "https://github.com/Wersky/taskswarm/issues"
  },
  "keywords": [
    "zcode",
    "zcode-plugin",
    "mcp",
    "mcp-server",
    "multi-agent",
    "orchestration",
    "task-decomposition",
    "任务蜂群"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "mcp/server.mjs",
  "bin": {
    "taskswarm-mcp": "mcp/server.mjs"
  },
  "files": [
    ".zcode-plugin",
    "commands",
    "mcp",
    "scripts",
    "skills"
  ],
  "scripts": {
    "test": "node --test \"mcp/test/**/*.test.mjs\"",
    "coverage": "node scripts/coverage.mjs",
    "sync": "node scripts/sync-installed.mjs"
  }
}
